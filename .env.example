# ==========================================================================
# AI_Trading_Bot configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# ---------------------------------------------------------------------------
# MetaTrader 5
# ---------------------------------------------------------------------------
# Path to the MT5 terminal EXE (used by python-MetaTrader5 initialize).
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Broker login/server (empty => login to the already-open terminal account).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# How many hours the BROKER server clock is AHEAD of UTC (can be negative/float).
# European brokers are commonly +2 (winter) / +3 (summer). This is used ONLY
# to translate MT5 candle times into the project's algorithmic NY clock (UTC-4).
# Verify against your broker; wrong values shift every session boundary.
MT5_SERVER_UTC_OFFSET=2

# ---------------------------------------------------------------------------
# Assets
# ---------------------------------------------------------------------------
# JSON file mapping strategy-name -> broker symbol + per-asset settings.
# This is the ONLY place instruments are configured — add FX, metals, indices or
# crypto and no strategy code changes. The file ships a broad watchlist with
# most entries disabled; turn them on per-asset from the dashboard, or all at
# once with:  python run.py assets --enable-all
ASSETS_FILE=assets.json

# Registry names are portable base names (XAUUSD, EURUSD, USTEC). When true the
# bot asks the connected terminal for the broker's actual spelling (XAUUSD ->
# XAUUSDm, USTEC -> US100) and selects it in Market Watch, so the same registry
# works across brokers. Set false to require exact symbol names in the file.
SYMBOL_AUTO_RESOLVE=true

# ---------------------------------------------------------------------------
# Trading safety
# ---------------------------------------------------------------------------
# Auto execution MUST stay OFF during development. When false the executor
# never calls MT5 order_send().
AUTO_TRADING=false

# Risk / entry rules
MIN_RR=1.5
TARGET_RR_RANGE=1.5,2.5
RISK_PERCENT=1.0
# SL buffer expressed in multiples of the ATR of the CISD timeframe.
SL_BUFFER_ATR=0.25
# Sessions during which entries are allowed (all sessions are still analyzed).
VALID_ENTRY_SESSIONS=london_open,ny_am,london_close,ny_pm,power_hour
# H1 purge before this NY hour => M15 CISD; at/after => M5 CISD.
CISD_THRESHOLD_HOUR_NY=9
# Max slippage tolerated on an entry, in points. Lot size is derived from the
# broker's own contract specification per asset (never from a fixed assumption).
ORDER_DEVIATION=20

# ---------------------------------------------------------------------------
# Scanner
# ---------------------------------------------------------------------------
SCANNER_POLL_INTERVAL_MS=5000
# Historical M1 candles replayed at live-session start to bring the engine's
# state up to "now". Signals found during warm-up are discarded, not alerted.
WARMUP_M1_BARS=5000
# Backtest default
BACKTEST_M1_BARS=20000

# ---------------------------------------------------------------------------
# Telegram (ALERT ONLY — never used for execution in v1)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# AI analysis layer (optional). If unset or unreachable the signal is marked
# AI_UNAVAILABLE and is still only an alert. AI can never override risk rules.
# ---------------------------------------------------------------------------
AI_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Flask dashboard
# ---------------------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
