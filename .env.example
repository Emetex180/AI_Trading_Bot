# ==========================================================================
# AI_Trading_Bot configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# ---------------------------------------------------------------------------
# MetaTrader 5
# ---------------------------------------------------------------------------
# Path to the MT5 terminal EXE (used by python-MetaTrader5 initialize).
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Broker login/server (empty => login to the already-open terminal account).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# How many hours the BROKER server clock is AHEAD of UTC (can be negative/float).
# LEAVE BLANK (recommended) to auto-detect: the bot measures the broker clock
# from the live terminal on connect and tracks the broker's own DST shifts.
# Set a number ONLY to pin a value you have verified; it then wins, and a
# disagreement with the terminal is logged as a WARNING.
MT5_SERVER_UTC_OFFSET=

# ---------------------------------------------------------------------------
# Assets
# ---------------------------------------------------------------------------
# JSON file mapping strategy-name -> broker symbol + per-asset settings.
# This is the ONLY place instruments are configured — add FX, metals, indices or
# crypto and no strategy code changes. The file ships a broad watchlist with
# most entries disabled; turn them on per-asset from the dashboard, or all at
# once with:  python run.py assets --enable-all
ASSETS_FILE=assets.json

# Registry names are portable base names (XAUUSD, EURUSD, USTEC). When true the
# bot asks the connected terminal for the broker's actual spelling (XAUUSD ->
# XAUUSDm, USTEC -> US100) and selects it in Market Watch, so the same registry
# works across brokers. Set false to require exact symbol names in the file.
SYMBOL_AUTO_RESOLVE=true

# ---------------------------------------------------------------------------
# Trading safety
# ---------------------------------------------------------------------------
# Auto execution MUST stay OFF during development. When false the executor
# never calls MT5 order_send().
AUTO_TRADING=false

# Risk / entry rules
MIN_RR=1.5
TARGET_RR_RANGE=1.5,2.5
RISK_PERCENT=1.0
# SL buffer expressed in multiples of the ATR of the CISD timeframe.
SL_BUFFER_ATR=0.25
# Sessions during which entries are allowed (all sessions are still analyzed).
VALID_ENTRY_SESSIONS=london_open,ny_premarket,ny_am,london_close,ny_pm
# H1 purge before this NY hour => M15 CISD; at/after => M5 CISD.
CISD_THRESHOLD_HOUR_NY=9
# Max slippage tolerated on an entry, in points. Lot size is derived from the
# broker's own contract specification per asset (never from a fixed assumption).
ORDER_DEVIATION=20

# ---------------------------------------------------------------------------
# Scanner
# ---------------------------------------------------------------------------
SCANNER_POLL_INTERVAL_MS=5000
# Historical M1 candles replayed at live-session start to bring the engine's
# state up to "now". Signals found during warm-up are discarded, not alerted.
WARMUP_M1_BARS=5000
# Backtest default
BACKTEST_M1_BARS=20000

# ---------------------------------------------------------------------------
# Telegram (ALERT ONLY — never used for execution in v1)
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A SECOND destination for the SAME alert: a broadcast channel. The message is
# built once and posted to both, so the chat and the channel can never disagree.
# Leave blank to send to TELEGRAM_CHAT_ID alone (the pre-channel behaviour).
# Use the channel's numeric id (e.g. -1001234567890), which survives a rename;
# @username works too, but only for a public channel. The bot must be able to
# post there — add it to the channel as an admin, or Telegram answers
# "chat not found" / "not enough rights".
TELEGRAM_CHANNEL_ID=
# Seconds to wait on a Telegram send before giving up. A stalled send must never
# hold up the scan loop, so this is short by design; the alert is logged either
# way, so a timeout costs the notification, not the signal.
TELEGRAM_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# AI analysis layer (optional). If unset or unreachable the signal is marked
# AI_UNAVAILABLE and is still only an alert. AI can never override risk rules.
# ---------------------------------------------------------------------------
AI_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Seconds to wait on the analysis call. Like the Telegram timeout, this is
# capped so a slow provider delays the alert rather than dropping the scan.
LLM_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy URL. Left blank the app uses SQLite at data/trading.db, which is
# what the deployment guide backs up and what holds every signal, backtest and
# audit line. Point it at PostgreSQL to move off SQLite; the schema is portable.
# Whatever you set here, back it up — the history in it is not reproducible.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Flask dashboard
# ---------------------------------------------------------------------------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Log the MT5 -> UTC -> New York -> ICT session conversion chain for each
# scanned candle (one trace per symbol per NY minute). Verification aid:
# leave on while confirming the conversion, then set false.
TIME_DEBUG=false

# ---------------------------------------------------------------------------
# Client platform: authentication, sessions and roles
# ---------------------------------------------------------------------------
# Flask signs the session cookie with this. If it is blank the app generates a
# temporary key at startup and logs a warning — everyone is signed out on every
# restart, which is annoying but not insecure. Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER commit this value, and give every deployment its own.
FLASK_SECRET_KEY=

# How long a signed-in session lasts before it must sign in again (hours).
SESSION_LIFETIME_HOURS=12

# Set TRUE once the site is served over HTTPS. A Secure cookie is never sent
# over plain HTTP, so leaving this true while testing on http://localhost would
# make sign-in impossible. It must be true in production.
SESSION_COOKIE_SECURE=false

# Trust X-Forwarded-For / X-Forwarded-Proto from the reverse proxy (IIS/ARR,
# nginx). Leave FALSE when the app is reached directly: otherwise a client can
# forge its own scheme and address through those headers.
TRUST_PROXY=false

# Waitress worker threads for `run.py serve`. Each open browser tab holds a
# thread only for the duration of a request (the pages poll rather than hold a
# connection open), so this does not need to match the client count.
SERVE_THREADS=8

# --- Engine startup ---------------------------------------------------------- #
# Whether `run.py web` / `run.py serve` start the trading engine themselves, so
# that starting the dashboard is starting the whole system: backend, MT5
# connection, market data, the scanner and the setup pipeline. With this true
# there is no second command and no second process to remember.
#
# The engine runs on a background thread inside the web process, exactly as the
# console's Start button has always run it, and the dashboard reads its state
# directly — one engine, one source of truth.
#
# The start is never forced. If another process already holds the engine lease
# (a `run.py scan` task, say), the web app stands down and reports *that*
# engine's state instead, so a deployment running the two as separate tasks
# still has exactly one scanner and no duplicate alerts.
#
# Set FALSE for a dashboard that should own no engine — watching a scanner
# started elsewhere, or any process that must not reach MT5.
ENGINE_AUTOSTART=true

# --- First-run administrator ------------------------------------------------ #
# Created ONCE, and only while the users table is empty. After that these values
# are ignored and the account is managed with `python run.py user ...`. Leave
# them blank and create the first admin from the command line instead — that
# keeps the password out of this file entirely.
#
# ADMIN_PASSWORD must satisfy MIN_PASSWORD_LENGTH or no admin is created and a
# warning is logged.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Login throttling and password policy ------------------------------------ #
# Failed attempts per username+address before a cooldown, and how long the
# cooldown lasts (minutes).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Minimum password length, enforced by `run.py user` and the admin console.
# Length only: no composition rules, which push people towards predictable
# substitutions without adding real strength.
MIN_PASSWORD_LENGTH=12

# Telegram (see its own section below) is a notification channel, not the
# product interface — the client platform is. TELEGRAM_ENABLED=false runs the
# scanner silently and makes every other Telegram setting irrelevant.

# ---------------------------------------------------------------------------
# ICT model: 1H liquidity purge -> 5M CISD -> 1M FVG -> retrace entry
#
# Every value below is optional; the defaults shown are the model's own and are
# what you get by leaving the line out. They are documented here because this is
# the tuning surface for the strategy.
# ---------------------------------------------------------------------------
# Timeframe the CISD is confirmed on. M15 applies before CISD_THRESHOLD_HOUR_NY
# (the London/premarket window), M5 at and after it. Overridable per asset.
CISD_TIMEFRAME=M5

# Stop loss = just beyond the 5M candle that took the liquidity, so the offset
# is the larger of these two. Ticks are used rather than "points" because a tick
# is 0.02 on a 2-digit index and 0.00002 on a 5-digit FX pair — one setting
# stays symbol-correct with no per-asset table.
SL_BUFFER_ATR=0.25
SL_MIN_OFFSET_TICKS=2.0

# Take profit = the nearest valid liquidity pull, placed slightly in front of the
# level so the order fills before the level does. Same tick reasoning as above.
TP_LIQUIDITY_OFFSET_ATR=0.1
TP_LIQUIDITY_OFFSET_TICKS=2.0
# Weakest liquidity grade acceptable as a take-profit target:
# VERY_HIGH | HIGH | MEDIUM_HIGH | MEDIUM | LOW.
MIN_TP_LIQUIDITY_GRADE=MEDIUM
# Minimum grade required to enter during a CONDITIONAL session (NY Premarket,
# London Close). Conditional sessions are half-conviction, so they demand a
# stronger premise than the unconditional ones.
CONDITIONAL_MIN_LIQUIDITY_GRADE=HIGH

# Timeouts. Each bounds one waiting stage, in closed M1 candles.
MAX_CISD_CANDLES=8
FVG_WAIT_M1=90
RETRACE_WAIT_M1=90

# Minimum FVG height as a fraction of the 5M ATR. A gap thinner than this is
# noise rather than displacement, so it does not qualify as an FVG and the
# search continues. The default 0.10 is deliberately conservative: it rejects a
# one-tick (or few-tick) gap on any instrument while leaving ordinary
# displacement gaps untouched, e.g. on USDCHF (1 tick = 0.00001, M5 ATR around
# 0.0004) it requires ~4 ticks. Set 0 to disable the filter entirely, which
# re-admits single-tick gaps.
FVG_MIN_ATR_FRAC=0.10

# Where the entry price must sit relative to the FVG. This is the rule that
# decides whether a retracement becomes a fill:
#   inside_fvg     (default) the entry candle must CLOSE within [low, high] of
#                  the gap, so the entry price is always a price inside the FVG.
#                  A close beyond the far boundary is refused.
#   reaction_close the older, looser rule: any close back beyond the gap that
#                  reclaims it counts, even if that close is OUTSIDE the zone.
#                  It can produce a signal whose entry price is not in the FVG
#                  at all. Opt in only deliberately.
FVG_ENTRY_MODEL=inside_fvg

# Liquidity lookbacks.
SWING_LOOKBACK=3
SESSION_LOOKBACK_DAYS=3

# 0 = unlimited. Any other value caps entries per session per asset.
MAX_SIGNALS_PER_SESSION=0
# Drop a pending setup when the clock enters a NO-TRADE session (Asian range,
# NY lunch) rather than letting it carry into dead time.
INVALIDATE_ON_NO_TRADE_SESSION=true
# When false, sessions are analyzed but never gate an entry. Diagnostics only.
ENFORCE_SESSIONS=true

# --- Activity gate (when the bot works at all) ------------------------------ #
# Independent of ENFORCE_SESSIONS above: that one filters *entries*, this one
# decides when the live loop is awake. A session that is "running" but asleep
# polls nothing and touches MT5 not at all.
#
# SESSION_GATE_ENABLED=true keeps the loop awake only inside a tradeable session
# on a trading day, and asleep otherwise. Set false for always-on scanning.
SESSION_GATE_ENABLED=true
# Days the bot runs. Anything outside this set is slept through, so the default
# is the Mon-Fri week. Names: mon,tue,wed,thu,fri,sat,sun. An empty or
# unrecognised list falls back to Mon-Fri. Per-asset override via
# ASSET_<NAME>_TRADING_DAYS.
#
# Note the interaction with VALID_ENTRY_SESSIONS above: a session excluded from
# that allow-list can never enter, so the gate will not wake for it either —
# with one deliberate exception. The Asian range (20:00-00:00) is a hard
# no-trade window the bot stays *awake* for regardless of the allow-list,
# because the high/low it builds is the liquidity London trades against. Awake
# there is not permission: nothing can be entered in that window.
TRADING_DAYS=mon,tue,wed,thu,fri

# Transparent efficiency score (0-100%), shown on every alert. Weights must sum
# to 1.0; each term is capped at 1 and the score is the weighted mean.
EFFICIENCY_RR_TARGET=3.0
EFFICIENCY_ATR_TARGET_MULTIPLE=4.0
EFFICIENCY_WEIGHT_RR=0.5
EFFICIENCY_WEIGHT_LIQUIDITY=0.3
EFFICIENCY_WEIGHT_DISTANCE=0.2
